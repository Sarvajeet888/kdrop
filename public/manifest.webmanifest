{
  "name": "K-Drop \u2014 send a file to the device next to you",
  "short_name": "K-Drop",
  "description": "Send files straight from one device to another. No account, no upload, nothing stored. By Kalman.",
  "start_url": "/?src=app",
  "display": "standalone",
  "background_color": "#EDE9E3",
  "theme_color": "#EDE9E3",
  "orientation": "any",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "categories": [
    "utilities",
    "productivity"
  ],
  "lang": "en",
  "id": "/",
  "scope": "/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Send files",
      "short_name": "Send",
      "url": "/?action=send",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Receive files",
      "short_name": "Receive",
      "url": "/?action=receive",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}