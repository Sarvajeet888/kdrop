{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KDrop",
  "version": "0.1.0",
  "identifier": "in.kalman.kdrop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "KDrop — nearby sharing", "width": 940, "height": 820, "minWidth": 640 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
