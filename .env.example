# K-Drop configuration.
# Every value has a working default. You only need this file if you want to
# change something. On Render, set these in the dashboard instead.

PORT=3000

# How long an idle session survives, in milliseconds. Default 30 minutes.
ROOM_TTL_MS=1800000

# Devices allowed in one session.
MAX_PEERS=8

# --- cost and abuse controls -------------------------------------------
# Bytes one session may push through the relay before being cut off.
# Direct transfers do not count against this — only the slower fallback
# route, which is the only thing that spends your bandwidth. Default 2 GB.
MAX_RELAY_BYTES=2147483648

# Simultaneous connections from one IP address.
MAX_SOCKETS_PER_IP=16

# Sessions one IP may start per hour.
MAX_ROOMS_PER_IP=30

# Sessions held in memory across the whole server.
MAX_ROOMS_TOTAL=5000

# --- proxy and access ---------------------------------------------------
# How many proxies sit in front of this app. The rate limiter reads the client
# address this many hops in from the right of x-forwarded-for. Reading the
# LEFT of that header lets anyone spoof it, which is why this is explicit.
#   1  Render, Railway, Fly.io, a single nginx  (default)
#   2  Cloudflare in front of one of those
#   0  no proxy at all — the header is ignored
TRUST_PROXY_HOPS=1

# Protects /api/metrics. Without it, that endpoint answers only to localhost.
# METRICS_TOKEN=your-long-random-token

# Overrides the host used in sitemap.xml and robots.txt. Usually unnecessary —
# they are generated from the request.
# PUBLIC_URL=https://kdrop.example.com

# --- abuse controls -----------------------------------------------------
MAX_JOIN_FAILS=20
MAX_MSGS_PER_10S=200
MAX_SESSION_MS=21600000
BAN_MS=900000

# --- optional TURN ------------------------------------------------------
# Lets devices connect directly on networks that would otherwise force the
# relay. Costs money. Skip it until relay bandwidth actually hurts.
# TURN_URL=turn:turn.example.com:3478
# Preferred with coturn REST API / use-auth-secret:
# TURN_SECRET=your-shared-turn-secret
# TURN_CREDENTIAL_TTL_SEC=3600
# Static-provider fallback:
# TURN_USER=your-turn-username
# TURN_PASS=your-turn-credential
